# 复制本文件为 .env 并填写后再启动

# ===== 运行模式 =====
# 已关闭全局 Mock，所有 AI 能力依赖真实 LLM / STT 配置
MOCK_MODE=false

# ===== SaaS / 多用户 =====
REQUIRE_AUTH=false
DATABASE_URL=sqlite:///./data/app.db
TOKEN_TTL_HOURS=168
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_EMAIL=admin@example.com

# ===== WebSocket 服务 =====
WS_HOST=127.0.0.1
WS_PORT=8765

# ===== 语音识别 STT =====
# 可选：aliyun | tencent | whisper | funasr
STT_PROVIDER=funasr

# —— 阿里云实时语音识别 ——
ALIYUN_NLS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_TOKEN=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# —— 腾讯云实时语音识别 ——
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# —— 本地 Whisper（离线）——
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# —— FunASR 流式（本地）——
FUNASR_MODEL=paraformer-zh-streaming
FUNASR_PUNC_MODEL=ct-punc
FUNASR_CHUNK_SIZE=0,10,5
FUNASR_ENCODER_CHUNK_LOOK_BACK=4
FUNASR_DECODER_CHUNK_LOOK_BACK=1

SAMPLE_RATE=16000

# ===== AI 模拟面试 =====
MOCK_INTERVIEW_DEFAULT_QUESTIONS=8
MOCK_INTERVIEW_MAX_QUESTIONS=12
MOCK_INTERVIEW_VOICE_ENABLED=true

# 大模型 API 已改为用户在前端「我的 → AI 服务商」自行配置，不再使用服务器 .env

RESUME_TEXT=

# ===== MinerU PDF 解析（路径 C 首选；用 D:/quant/venv 安装 mineru[pipeline]）=====
MINERU_ENABLED=true
MINERU_PYTHON=D:/quant/venv/Scripts/python.exe
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_MODEL_SOURCE=modelscope
MINERU_OCR_IMAGES=true
MINERU_TIMEOUT_SEC=600

